      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// Normaliza, sanitiza y valida el lead ANTES de tocar ningun sistema externo.\n// Cada regla de aca sale de una falla medida en la version A: ver fallas-version-A.md\n\nconst MAX_PAYLOAD = 64 * 1024;   // bytes del body crudo\nconst MAX_FIELD   = 2000;        // caracteres por campo de texto\n\n// HubSpot rechaza emails con espacios, y su mensaje de error se los come:\n// muestra un email que parece valido y lo llama invalido. Recortar es obligatorio.\nconst EMAIL_RE = /^[^\\s@]+@[^\\s@]+\\.[^\\s@]{2,}$/;\n\n// Quita HTML/JS y neutraliza formulas de planilla.\n// Un payload con <script> no lo rechaza HubSpot: lo bloquea Cloudflare, y el\n// error que vuelve dice \"check your credentials\". Sanitizar evita esa pista falsa.\nfunction sanitize(v) {\n  if (typeof v !== 'string') return '';\n  let s = v.replace(/<[^>]*>/g, '');                   // etiquetas HTML\n  s = s.replace(/[\\u0000-\\u001F\\u007F]/g, ' ');     // caracteres de control\n  s = s.replace(/\\s+/g, ' ').trim();\n  // Si arranca con = + - @ la planilla destino lo evalua como formula.\n  if (/^[=+\\-@]/.test(s)) s = \"'\" + s;\n  return s;\n}\n\n// Normaliza a E.164. Uruguay por defecto; cambiar segun el cliente.\nfunction normalizePhone(raw, defaultCountry = '598') {\n  if (typeof raw !== 'string' || !raw.trim()) return null;\n  let d = raw.replace(/[^\\d+]/g, '');\n  if (d.startsWith('00')) d = '+' + d.slice(2);\n  if (!d.startsWith('+')) d = '+' + defaultCountry + d.replace(/^0+/, '');\n  return /^\\+[1-9]\\d{7,14}$/.test(d) ? d : null;\n}\n\nconst out = [];\n\nfor (const item of $input.all()) {\n  const body = item.json.body ?? {};\n  const raw = JSON.stringify(body);\n  const errors = [];\n\n  // 1. Tamanio primero: no gastar una llamada a la API en un payload absurdo.\n  if (raw.length > MAX_PAYLOAD) {\n    errors.push('payload demasiado grande: ' + raw.length + ' bytes, maximo ' + MAX_PAYLOAD);\n  }\n\n  // 2. Email: recortar y bajar a minusculas ANTES de validar.\n  const email = typeof body.email === 'string' ? body.email.trim().toLowerCase() : '';\n  if (!email) errors.push('falta el campo requerido: email');\n  else if (!EMAIL_RE.test(email)) errors.push('email invalido: \"' + email + '\"');\n\n  // 3. Nombre requerido.\n  const first_name = sanitize(body.first_name).slice(0, MAX_FIELD);\n  if (!first_name) errors.push('falta el campo requerido: first_name');\n\n  // 4. Telefono opcional, pero si viene tiene que normalizar.\n  const phone = normalizePhone(body.phone);\n  if (body.phone && !phone) errors.push('telefono no normalizable a E.164: \"' + body.phone + '\"');\n\n  const lead = {\n    email,\n    first_name,\n    last_name: sanitize(body.last_name).slice(0, MAX_FIELD),\n    phone,\n    company: sanitize(body.company).slice(0, MAX_FIELD),\n    message: sanitize(body.message).slice(0, MAX_FIELD),\n    source: sanitize(body.source) || 'unknown',\n    received_at: new Date().toISOString(),\n  };\n\n  out.push({\n    json: {\n      ok: errors.length === 0,\n      errors,\n      dedupe_key: email,\n      lead,\n      raw_payload: raw.slice(0, 8000),\n    },\n  });\n}\n\nreturn out;\n"
      }
