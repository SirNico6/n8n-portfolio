{
  "name": "caso-01 - manejo de errores",
  "nodes": [
    {
      "id": "cccc1111-1111-4111-8111-111111111111",
      "name": "Cuando falla un workflow",
      "type": "n8n-nodes-base.errorTrigger",
      "typeVersion": 1,
      "position": [
        -300,
        0
      ],
      "parameters": {}
    },
    {
      "id": "cccc2222-2222-4222-8222-222222222222",
      "name": "Armar la alerta",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -60,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// Arma la alerta a partir del payload del Error Trigger.\n// Incluye link directo a la ejecucion: sin eso, el que recibe la alerta\n// tiene que buscar a mano en n8n y no lo hace.\n\nconst e = $json.execution ?? {};\nconst w = $json.workflow ?? {};\n\nconst lineas = [\n  'Fallo el workflow: ' + (w.name ?? 'desconocido'),\n  'Nodo: ' + (e.lastNodeExecuted ?? 'desconocido'),\n  'Error: ' + (e.error?.message ?? 'sin mensaje'),\n  'Ejecucion: ' + (e.id ?? '?'),\n];\nif (e.url) lineas.push('Abrir: ' + e.url);\n\nreturn [{\n  json: {\n    alerta: lineas.join('\\n'),\n    execution_id: String(e.id ?? ''),\n    workflow_name: w.name ?? '',\n    error_message: e.error?.message ?? 'sin mensaje',\n    error_node: e.lastNodeExecuted ?? 'desconocido',\n    payload: JSON.stringify($json).slice(0, 8000),\n  },\n}];\n"
      }
    },
    {
      "id": "cccc3333-3333-4333-8333-333333333333",
      "name": "Registrar el fallo",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1.1,
      "position": [
        180,
        80
      ],
      "parameters": {
        "resource": "row",
        "operation": "insert",
        "dataTableId": {
          "__rl": true,
          "value": "W8yrbsUnaw9DEKXT",
          "mode": "id"
        },
        "columns": {
