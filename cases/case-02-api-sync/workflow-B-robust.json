    {
      "id": "ca02b001-0005-4005-8005-000000000005",
      "name": "Normalize and verify",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// Normalizes the fetched records and ASSERTS that we got all of them.\n//\n// This assertion is the whole point of the rescue. Every other fix still leaves\n// you trusting that the sync is healthy because nothing errored — and it was\n// never erroring. A sync that silently returns 8% of the data has to be as\n// noisy as one that crashes.\n\n// The source total, taken from the Link header of a per_page=1 probe.\n// With one item per page, the last page number IS the record count.\nconst probe = $('Measure the source').first().json;\nconst linkHeader = (probe.headers && (probe.headers.link || probe.headers.Link)) || '';\nconst lastMatch = linkHeader.match(/[?&]page=(\\d+)>;\\s*rel=\"last\"/);\nconst expected = lastMatch ? Number(lastMatch[1]) : null;\n\n// Deduplicate within the batch on a stable key, so a record appearing on a\n// page boundary twice does not count twice.\nconst seen = new Map();\nfor (const item of $input.all()) {\n  const r = item.json;\n  if (!r || !r.login) continue;\n  if (!seen.has(r.login)) {\n    seen.set(r.login, {\n      login: String(r.login),\n      github_id: String(r.id ?? ''),\n      contributions: Number(r.contributions ?? 0),\n      synced_at: new Date().toISOString(),\n    });\n  }\n}\n\nconst fetched = seen.size;\nconst pages = Math.max(1, Math.ceil(fetched / 100));\n\n// No Link header means a single page: expected equals what we got.\nconst target = expected === null ? fetched : expected;\nconst complete = fetched >= target;\n\nconst summary = {\n  complete,\n  expected: target,\n  fetched,\n  missing: Math.max(0, target - fetched),\n  pages,\n  note: complete\n    ? 'retrieved ' + fetched + ' of ' + target + ' records'\n    : 'INCOMPLETE: retrieved ' + fetched + ' of ' + target + ', missing ' + (target - fetched),\n};\n\n// One item per record, each carrying the run summary so the logging step can\n// read it without recomputing. If nothing came back at all, still emit one\n// item so the assertion downstream can fail loudly instead of the workflow\n// quietly ending with zero items.\nif (!seen.size) return [{ json: { _summary: summary, _empty: true } }];\nreturn [...seen.values()].map((rec) => ({ json: { ...rec, _summary: summary } }));\n"
      }
    },
