    {
      "id": "bbbb2222-2222-4222-8222-222222222222",
      "name": "Normalize and validate",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -240,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// Normalize, sanitize and validate the lead BEFORE touching any external system.\n// Every rule here comes from a measured failure of version A: see version-A-failures.md\n\nconst MAX_PAYLOAD = 64 * 1024;   // bytes of the raw body\nconst MAX_FIELD   = 2000;        // characters per text field\n\n// HubSpot rejects emails containing whitespace, and its error message trims it\n// away: it shows you an email that looks valid and calls it invalid.\n// Trimming before validating is not optional.\nconst EMAIL_RE = /^[^\\s@]+@[^\\s@]+\\.[^\\s@]{2,}$/;\n\n// Strips HTML/JS and neutralizes spreadsheet formulas.\n// A payload containing <script> is not rejected by HubSpot: it is blocked by\n// Cloudflare, and the error that comes back says \"check your credentials\".\n// Sanitizing avoids that false trail.\nfunction sanitize(v) {\n  if (typeof v !== 'string') return '';\n  let s = v.replace(/<[^>]*>/g, '');                   // HTML tags\n  s = s.replace(/[\\u0000-\\u001F\\u007F]/g, ' ');     // control characters\n  s = s.replace(/\\s+/g, ' ').trim();\n  // A field starting with = + - @ is evaluated as a formula by the target spreadsheet.\n  if (/^[=+\\-@]/.test(s)) s = \"'\" + s;\n  return s;\n}\n\n// Normalizes to E.164. Uruguay by default; change per client.\nfunction normalizePhone(raw, defaultCountry = '598') {\n  if (typeof raw !== 'string' || !raw.trim()) return null;\n  let d = raw.replace(/[^\\d+]/g, '');\n  if (d.startsWith('00')) d = '+' + d.slice(2);\n  if (!d.startsWith('+')) d = '+' + defaultCountry + d.replace(/^0+/, '');\n  return /^\\+[1-9]\\d{7,14}$/.test(d) ? d : null;\n}\n\nconst out = [];\n\nfor (const item of $input.all()) {\n  const body = item.json.body ?? {};\n  const raw = JSON.stringify(body);\n  const errors = [];\n\n  // 1. Size first: do not spend an API call on an absurd payload.\n  if (raw.length > MAX_PAYLOAD) {\n    errors.push('payload too large: ' + raw.length + ' bytes, maximum ' + MAX_PAYLOAD);\n  }\n\n  // 2. Email: trim and lowercase BEFORE validating.\n  const email = typeof body.email === 'string' ? body.email.trim().toLowerCase() : '';\n  if (!email) errors.push('missing required field: email');\n  else if (!EMAIL_RE.test(email)) errors.push('invalid email: \"' + email + '\"');\n\n  // 3. Name is required.\n  const first_name = sanitize(body.first_name).slice(0, MAX_FIELD);\n  if (!first_name) errors.push('missing required field: first_name');\n\n  // 4. Phone is optional, but if present it has to normalize.\n  const phone = normalizePhone(body.phone);\n  if (body.phone && !phone) errors.push('phone cannot be normalized to E.164: \"' + body.phone + '\"');\n\n  const lead = {\n    email,\n    first_name,\n    last_name: sanitize(body.last_name).slice(0, MAX_FIELD),\n    phone,\n    company: sanitize(body.company).slice(0, MAX_FIELD),\n    message: sanitize(body.message).slice(0, MAX_FIELD),\n    source: sanitize(body.source) || 'unknown',\n    received_at: new Date().toISOString(),\n  };\n\n  out.push({\n    json: {\n      ok: errors.length === 0,\n      errors,\n      dedupe_key: email,\n      lead,\n      raw_payload: raw.slice(0, 8000),\n    },\n  });\n}\n\nreturn out;\n"
      }
