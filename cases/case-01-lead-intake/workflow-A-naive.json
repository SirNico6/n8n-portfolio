            },
            {
              "id": "f2",
              "name": "first_name",
              "value": "={{ $json.body.first_name }}",
              "type": "string"
            },
            {
              "id": "f3",
              "name": "last_name",
              "value": "={{ $json.body.last_name }}",
              "type": "string"
            },
            {
              "id": "f4",
              "name": "phone",
