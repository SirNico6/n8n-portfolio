              "type": "string"
            },
            {
              "id": "f5",
              "name": "company",
              "value": "={{ $json.body.company }}",
              "type": "string"
            },
            {
              "id": "f6",
              "name": "message",
              "value": "={{ $json.body.message }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "aaaa3333-3333-4333-8333-333333333333",
      "name": "Create contact in HubSpot",
      "position": [
        220,
        0
      ],
      "type": "n8n-nodes-base.hubspot",
      "typeVersion": 2.2,
      "parameters": {
        "authentication": "appToken",
        "resource": "contact",
        "operation": "upsert",
        "email": "={{ $json.email }}",
        "additionalFields": {
          "firstName": "={{ $json.first_name }}",
          "lastName": "={{ $json.last_name }}",
          "phoneNumber": "={{ $json.phone }}",
          "companyName": "={{ $json.company }}",
          "message": "={{ $json.message }}"
        },
        "options": {}
      }
    },
    {
      "id": "aaaa4444-4444-4444-8444-444444444444",
      "name": "Notify the team",
      "position": [
        440,
        0
      ],
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "parameters": {
        "resource": "message",
        "operation": "sendMessage",
        "chatId": "REPLACE_WITH_YOUR_CHAT_ID",
        "text": "=New lead: {{ $('Map fields').item.json.first_name }} {{ $('Map fields').item.json.last_name }} - {{ $('Map fields').item.json.email }} - {{ $('Map fields').item.json.company }}",
        "additionalFields": {
          "appendAttribution": false
        }
      }
    }
