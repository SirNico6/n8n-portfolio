{
  "name": "case-01 · error handler",
  "nodes": [
    {
      "id": "cccc1111-1111-4111-8111-111111111111",
      "name": "When a workflow fails",
      "type": "n8n-nodes-base.errorTrigger",
      "typeVersion": 1,
      "position": [
        -300,
        0
      ],
      "parameters": {}
    },
    {
      "id": "cccc2222-2222-4222-8222-222222222222",
      "name": "Build the alert",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -60,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// Builds the alert from the Error Trigger payload.\n// Includes a direct link to the failed execution: without it, whoever receives\n// the alert has to hunt for it in n8n, and they won't.\n\nconst e = $json.execution ?? {};\nconst w = $json.workflow ?? {};\n\nconst lines = [\n  'Workflow failed: ' + (w.name ?? 'unknown'),\n  'Node: ' + (e.lastNodeExecuted ?? 'unknown'),\n  'Error: ' + (e.error?.message ?? 'no message'),\n  'Execution: ' + (e.id ?? '?'),\n];\nif (e.url) lines.push('Open: ' + e.url);\n\nreturn [{\n  json: {\n    alert: lines.join('\\n'),\n    execution_id: String(e.id ?? ''),\n    workflow_name: w.name ?? '',\n    error_message: e.error?.message ?? 'no message',\n    error_node: e.lastNodeExecuted ?? 'unknown',\n    payload: JSON.stringify($json).slice(0, 8000),\n  },\n}];\n"
      }
    },
    {
      "id": "cccc3333-3333-4333-8333-333333333333",
      "name": "Log the failure",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1.1,
      "position": [
        180,
        80
      ],
      "parameters": {
        "resource": "row",
        "operation": "insert",
        "dataTableId": {
          "__rl": true,
          "value": "REPLACE_WITH_YOUR_DATA_TABLE_ID",
          "mode": "id"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "matchingColumns": [],
          "value": {
            "received_at": "={{ $now.toISO() }}",
            "email": "(unhandled failure)",
            "payload": "={{ $json.payload }}",
            "error_message": "={{ $json.error_message }}",
            "error_node": "={{ $json.error_node }}",
            "execution_id": "={{ $json.execution_id }}",
            "workflow_name": "={{ $json.workflow_name }}"
          },
          "schema": [
            {
              "id": "received_at",
              "displayName": "received_at",
              "type": "string",
              "required": false,
              "canBeUsedToMatch": true,
              "display": true,
              "defaultMatch": false
            },
            {
