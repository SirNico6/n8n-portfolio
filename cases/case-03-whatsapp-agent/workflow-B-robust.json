      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $json.api_base }}/{{ $json.config_phone_number_id }}/messages",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ messaging_product: \"whatsapp\", recipient_type: \"individual\", to: $json.from, type: \"text\", text: { body: $json.reply } }) }}",
        "options": {
          "timeout": 15000
