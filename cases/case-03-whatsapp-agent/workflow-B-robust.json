    {
      "parameters": {
        "jsCode": "// Normalize before anything else looks at this: the dedupe key, the\n// consent log and the reply all have to agree on one shape.\nconst body = $json.body;\nconst change = body?.entry?.[0]?.changes?.[0];\nconst value = change?.value ?? {};\nconst message = value.messages?.[0];\n\nif (!message) {\n  throw new Error('No inbound message in payload; this branch should not have run');\n}\n\nfunction clean(v) {\n  if (typeof v !== 'string') return '';\n  return v.replace(/[\\u0000-\\u001F\\u007F]/g, ' ').replace(/\\s+/g, ' ').trim();\n}\n\n// Text lives in a different place for every message type, and a\n// sticker or a location has no text at all.\nconst type = message.type ?? 'unknown';\nconst text = clean(\n  message.text?.body ??\n  message.button?.text ??\n  message.interactive?.button_reply?.title ??\n  message.interactive?.list_reply?.title ??\n  ''\n);\n\nconst profileName = clean(value.contacts?.[0]?.profile?.name ?? '');\n\nreturn [{ json: {\n  message_id: message.id,\n  from: message.from,\n  profile_name: profileName,\n  type,\n  text,\n  supported: type === 'text' || type === 'button' || type === 'interactive',\n  wa_timestamp: message.timestamp ?? null,\n  phone_number_id: value.metadata?.phone_number_id ?? null,\n  api_base: $json.api_base,\n  config_phone_number_id: $json.phone_number_id,\n} }];"
      },
      "id": "c3-024",
      "name": "Normalize the message",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        160
      ]
    },
    {
      "parameters": {
        "operation": "removeItemsSeenInPreviousExecutions",
        "logic": "removeItemsWithAlreadySeenKeyValues",
        "dedupeValue": "={{ $json.message_id }}",
        "options": {
          "scope": "workflow",
          "historySize": 10000
        }
      },
      "id": "c3-025",
      "name": "Seen this message before?",
      "type": "n8n-nodes-base.removeDuplicates",
      "typeVersion": 2,
      "position": [
        880,
