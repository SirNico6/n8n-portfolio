      "id": "c3-026",
      "name": "Log consent and inbound",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1.1,
      "position": [
        1100,
        160
      ]
    },
    {
      "parameters": {
        "jsCode": "const started = Date.now();\nconst item = $input.first().json;\n\n// A sticker, an image or a location carries no text to answer. Decline it\n// explicitly. The generic fallback would read as if the bot had understood.\nif (!item.supported) {\n  return [{ json: { ...item, declined: true, reply: 'Por ahora solo puedo leer mensajes de texto. Escribime tu consulta y te respondo.', thought_for_ms: Date.now() - started } }];\n}\n\nawait new Promise((resolve) => setTimeout(resolve, 3000));\n\nconst text = (item.text || '').toLowerCase();\n\nlet reply;\nif (text.includes('precio') || text.includes('costo')) {\n  reply = 'Te paso con un asesor para una cotizacion. Un momento.';\n} else if (text.includes('hola') || text.includes('buenas')) {\n  reply = 'Hola! Contame en que te puedo ayudar.';\n} else {\n  reply = 'Recibido. Un asesor te responde en breve.';\n}\n\nreturn [{ json: { ...item, reply, thought_for_ms: Date.now() - started } }];"
      },
      "id": "c3-027",
      "name": "Think about the answer",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1320,
