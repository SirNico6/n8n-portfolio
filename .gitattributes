# Line ending normalization.
# Without this, git stores CRLF on Windows and a .sh file cloned on Linux
# fails with "bad interpreter: No such file or directory".

* text=auto eol=lf

*.sh      text eol=lf
*.json    text eol=lf
*.md      text eol=lf
*.yml     text eol=lf
*.yaml    text eol=lf

*.png     binary
*.jpg     binary
*.mp4     binary
