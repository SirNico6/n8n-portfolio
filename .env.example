# Copy to .env and fill in. The .env file is never committed.

# n8n credential encryption key. Generate one locally and do not lose it:
# without it, n8n cannot decrypt the credentials it has stored.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
N8N_ENCRYPTION_KEY=

# Base URL for webhooks and the Form Trigger. Without this the nodes show
# unusable URLs.
WEBHOOK_URL=http://localhost:5678/

# Only because this runs locally over http.
N8N_SECURE_COOKIE=false

# Default timezone for schedules.
GENERIC_TIMEZONE=America/Montevideo

# API key for the LOCAL instance, used by the n8n MCP.
# Generated inside n8n under Settings -> n8n API.
# Never point this at a client's instance.
N8N_API_URL=http://localhost:5678/api/v1
N8N_API_KEY=

# HubSpot service key (pat- prefix). Created under:
# HubSpot -> Development -> Keys -> Service Keys
# Scopes: crm.objects.contacts.read + crm.objects.contacts.write
#
# Note: n8n does NOT read credentials from this file. It stores them in its own
# encrypted store, added through the node's UI. This variable exists only for
# this repo's verification scripts.
HUBSPOT_SERVICE_KEY=

# Telegram bot token, from @BotFather (the verified one — there are impostors).
TELEGRAM_BOT_TOKEN=

# Destination chat id for notifications. Resolve it with:
#   curl "https://api.telegram.org/bot$TELEGRAM_BOT_TOKEN/getUpdates"
# after sending the bot a message.
TELEGRAM_CHAT_ID=
