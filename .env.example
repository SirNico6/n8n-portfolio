# Copiar a .env y completar. El .env NO se commitea.

# Clave de cifrado de credenciales de n8n. Generar una local y no perderla:
# sin ella, n8n no puede descifrar las credenciales guardadas.
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
N8N_ENCRYPTION_KEY=

# URL base para webhooks y Form Trigger. Sin esto los nodos muestran URLs inusables.
WEBHOOK_URL=http://localhost:5678/

# Solo porque corre local sobre http.
N8N_SECURE_COOKIE=false

# Zona horaria por defecto de los schedules.
GENERIC_TIMEZONE=America/Montevideo

# API key de la instancia LOCAL, para el MCP de n8n.
# Se genera dentro de n8n en Settings -> n8n API.
# Nunca apuntar esto a una instancia de un cliente.
N8N_API_URL=http://localhost:5678/api/v1
N8N_API_KEY=
